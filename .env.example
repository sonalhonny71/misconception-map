# Copy this file to backend/.env (the start script does it for you) and edit as needed.
# Never commit the real .env file: it is ignored by git.

# --- Local development (works out of the box, no database server needed) ---
DATABASE_URL=sqlite:///./misconceptionmap.db
# DATABASE_URL_DIRECT is only needed for Neon/Postgres (migrations use it; falls back to DATABASE_URL)
# DATABASE_URL_DIRECT=

# Any long random text; generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-for-production

# development | production | test  (test skips migrations/seeding at start-up)
ENV=development

# Comma-separated list of web addresses allowed to call the API from a browser
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000

# --- Production / Postgres example (Neon): ---
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
